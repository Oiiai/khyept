{
    "target": "exec",
    "interactive": true,
    "shell_cmd": "kyptc \"$file\"",
    "working_dir": "${file_path%\\*}",
    "selector": "source.khyept",
    "file_regex": "运行错误：(?P<message>.*)$",
    "encoding": "utf-8",
    "quiet": false,
    "variants": [
        {
            "name": "Run with kyptc",
            "shell_cmd": "kyptc \"$file\""
        },
        {
            "name": "Build with cargo (release)",
            "shell_cmd": "./build.sh build --release"
        }
    ]
}