# 语法与打包配置必须是 LF：CRLF 会让 tmLanguage / sublime-syntax 解析异常
# （这些规则以前写在 .gitignore 里，那是不起作用的，已移到此处）
*.tmLanguage.json text eol=lf
vscode-khyept/snippets/*.json text eol=lf
vscode-khyept/package.json text eol=lf
vscode-khyept/language-configuration.json text eol=lf
sublime-khyept/*.sublime-syntax text eol=lf
sublime-khyept/*.sublime-build text eol=lf
*.sh text eol=lf
