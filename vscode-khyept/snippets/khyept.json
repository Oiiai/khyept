{
  "Function declaration": {
    "prefix": "fn",
    "body": [
      "fn ${1:void} ${2:name}(${3}) {",
      "\t$0",
      "}"
    ],
    "description": "Create a Khyept function"
  },
  "Immutable variable": {
    "prefix": "let",
    "body": "let ${1:type} ${2:name} = ${3:value};$0",
    "description": "Create an immutable Khyept variable"
  },
  "Mutable variable": {
    "prefix": "var",
    "body": "var ${1:type} ${2:name} = ${3:value};$0",
    "description": "Create a mutable Khyept variable"
  },
  "Print line": {
    "prefix": "pln",
    "body": "println(${1:value});$0",
    "description": "Print a line"
  },
  "Print without newline": {
    "prefix": "pr",
    "body": "print(${1:value});$0",
    "description": "Print without a newline"
  }
}
