{
  "name": "khyept-language-support",
  "displayName": "Khyept Language Support",
  "description": "Syntax highlighting and editor support for the Khyept programming language.",
  "version": "0.1.1",
  "publisher": "khyept",
  "license": "MIT",
  "engines": {
    "vscode": ">=1.70.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "khyept",
        "aliases": ["Khyept", "khyept"],
        "extensions": [".khyept", ".kypt"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "khyept",
        "scopeName": "source.khyept",
        "path": "./syntaxes/khyept.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "khyept",
        "path": "./snippets/khyept.json"
      }
    ]
  }
}
