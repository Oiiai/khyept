{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Khyept",
  "scopeName": "source.khyept",
  "fileTypes": ["khyept", "kypt"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#structs" },
    { "include": "#functions" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#builtins" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "structs": {
      "patterns": [
        {
          "match": "\\b(struct)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.struct.khyept" },
            "2": { "name": "entity.name.type.struct.khyept" }
          }
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.khyept",
          "match": "///.*$"
        },
        {
          "name": "comment.block.khyept",
          "begin": "/\\*",
          "end": "\\*/",
          "beginCaptures": { "0": { "name": "punctuation.definition.comment.begin.khyept" } },
          "endCaptures": { "0": { "name": "punctuation.definition.comment.end.khyept" } },
          "patterns": [
            {
              "name": "comment.block.documentation.khyept",
              "begin": "^\\s*\\*",
              "end": "$"
            }
          ]
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.fstring.khyept",
          "begin": "(f)\"",
          "end": "\"",
          "beginCaptures": {
            "1": { "name": "storage.type.format.khyept" }
          },
          "patterns": [
            { "include": "#escapes" },
            {
              "name": "meta.interpolation.khyept",
              "begin": "\\{",
              "end": "\\}",
              "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.khyept" } },
              "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.khyept" } },
              "patterns": [
                { "include": "#constants" },
                { "include": "#numbers" },
                { "include": "#operators" },
                { "include": "#functions" },
                { "include": "#structs" },
                { "include": "#keywords" },
                { "name": "variable.other.khyept", "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b" }
              ]
            }
          ]
        },
        {
          "name": "string.quoted.double.khyept",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.khyept" } },
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.khyept" } },
          "patterns": [{ "include": "#escapes" }]
        },
        {
          "name": "string.quoted.single.khyept",
          "begin": "'",
          "end": "'",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.khyept" } },
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.khyept" } },
          "patterns": [{ "include": "#escapes" }]
        }
      ]
    },
    "escapes": {
      "patterns": [
        {
          "name": "constant.character.escape.khyept",
          "match": "\\\\(?:[ntrbfva0\\\\\"']|[1-7][0-7]{0,2}|x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8})"
        },
        {
          "name": "invalid.illegal.bad-escape.khyept",
          "match": "\\\\."
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.khyept",
          "match": "\\b(?:let|var|global|fn|return|break|continue)\\b"
        },
        {
          "name": "keyword.control.flow.khyept",
          "match": "\\b(?:if|elif|else|switch|case|default|while|for|do)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.khyept",
          "match": "\\b(?:int|float|string|bool|void|list|dict)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.khyept",
          "match": "\\b(?:true|false|null)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.khyept",
          "match": "\\b(?:len|size|int|float|string|bool|type|readln|print|println|open)\\b(?=\\s*\\()"
        },
        {
          "name": "support.function.file.khyept",
          "match": "(?<=\\.)(?:read|write|writeln|close|size)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "\\bfn\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "entity.name.function.khyept" }
          }
        },
        {
          "name": "entity.name.function.call.khyept",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
        }
      ]
    },
    "numbers": {
      "comment": "词法器只支持十进制：整数与小数。0x / 0b / 科学计数法都不合法，故不高亮。",
      "patterns": [
        {
          "name": "constant.numeric.float.khyept",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.khyept",
          "match": "\\b[0-9]+\\b(?![eE0-9])"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.khyept",
          "match": "==|!=|<=|>|<"
        },
        {
          "name": "keyword.operator.range.khyept",
          "match": "\\.\\.\\.|<\\.\\.|\\.\\.<"
        },
        {
          "name": "keyword.operator.assignment.khyept",
          "match": ":=|=|\\+=|-=|\\*=|/=|%="
        },
        {
          "name": "keyword.operator.increment.khyept",
          "match": "\\+\\+|--"
        },
        {
          "name": "keyword.operator.arithmetic.khyept",
          "match": "\\*\\*|//|[+\\-*/%]"
        },
        {
          "name": "keyword.operator.bitwise.khyept",
          "match": "<<|>>|&|\\||\\^|~"
        },
        {
          "name": "keyword.operator.logical.khyept",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.arrow.khyept",
          "match": "->"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.accessor.khyept",
          "match": "\\."
        },
        {
          "name": "punctuation.separator.khyept",
          "match": ";|,|:"
        },
        {
          "name": "punctuation.bracket.khyept",
          "match": "[{}\\[\\]()]"
        }
      ]
    }
  }
}