{
  "$schema": "https://raw.githubusercontent.com/martinring/ไม่-syntax/master/tmlanguage.json",
  "name": "Khyept",
  "scopeName": "source.khyept",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#structs" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#functions" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "structs": {
      "patterns": [
        {
          "match": "\\b(struct)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.struct.khyept" },
            "2": { "name": "entity.name.type.struct.khyept" }
          }
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.khyept",
          "match": "///.*$"
        },
        {
          "name": "comment.block.khyept",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.khyept",
          "begin": "f\\\"",
          "end": "\\\"",
          "beginCaptures": {
            "0": { "name": "storage.type.format.khyept" }
          },
          "patterns": [
            {
              "name": "constant.character.escape.khyept",
              "match": "\\\\(?:[ntrbfva0\\\\\\\"']|[1-7][0-7]{0,2}|x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8})"
            },
            {
              "name": "meta.interpolation.khyept",
              "begin": "\\{",
              "end": "\\}",
              "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.khyept" } },
              "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.khyept" } },
              "patterns": [
                { "include": "#constants" },
                { "include": "#numbers" },
                { "include": "#operators" },
                { "include": "#functions" },
                { "name": "variable.other.khyept", "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b" }
              ]
            }
          ]
        },
        {
          "name": "string.quoted.double.khyept",
          "begin": "\\\"",
          "end": "\\\"",
          "patterns": [
            {
              "name": "constant.character.escape.khyept",
              "match": "\\\\(?:[ntrbfva0\\\\\\\"']|[1-7][0-7]{0,2}|x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8})"
            }
          ]
        },
        {
          "name": "string.quoted.single.khyept",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.khyept",
              "match": "\\\\(?:[ntrbfva0\\\\\\\"']|[1-7][0-7]{0,2}|x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8})"
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.khyept",
          "match": "\\b(?:let|var|struct|fn|return|global|if|elif|else|switch|case|default)\\b"
        },
        {
          "name": "keyword.control.khyept",
          "match": "\\b(?:while|for|do|break|continue)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.khyept",
          "match": "\\b(?:int|float|string|bool|void)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.khyept",
          "match": "\\b(?:true|false|null)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "\\bfn\\s+(?:(?:int|float|string|bool|void)\\s+)?([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()",
          "captures": {
            "1": { "name": "entity.name.function.khyept" }
          }
        },
        {
          "name": "entity.name.function.call.khyept",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.khyept",
          "match": "\\b(?:0[xX][0-9A-Fa-f]+|0[bB][01]+|(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.khyept",
          "match": "===|!==|\\+\\+|--|\\+=|-=|\\*=|/=|%=|==|!=|<=|>=|\\.\\.\\.|<\\.\\.|\\.\\.<|=|\\+|-|\\*|/|%|<|>|!"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.khyept",
          "match": ";|,|:|\\."
        },
        {
          "name": "punctuation.bracket.khyept",
          "match": "[{}\\[\\]()]"
        }
      ]
    }
  }
}
