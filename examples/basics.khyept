/// Khyept 示例
let num : int = 123;
var num1 : int = 123;
num1 = 456;
println(f"num={num}, num1={num1}");

fn add(a : int, b : int) -> int {
    return(a + b);
}

fn main() {
    var result : int = add(num, num1);
    println(f"result={result}");
    let name : string = readln("请输入名字: ");
    println(f"你好，{name}!");
}

main();

let age : int = 20;
let category : string = if (age >= 18) { "adult" } else { "minor" };
println(category);
